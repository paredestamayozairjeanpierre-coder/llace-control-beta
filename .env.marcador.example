# PC de una TIENDA (marcador). Copiar como ".env" en esa PC.
# Usuario con permisos limitados (crear con scripts/crear_roles_db.py)
DATABASE_URL=postgresql+psycopg://llace_marcador:CLAVE@HOST_DE_LA_NUBE:5432/NOMBRE_BD

# Código de la tienda de ESTA PC (debe existir en la tabla tiendas): PL, EC o GL
TIENDA_CODIGO=PL

# 0 = el trabajador solo puede marcar en su tienda | 1 = puede marcar en cualquiera
MARCADOR_PERMITIR_OTRA_TIENDA=0
